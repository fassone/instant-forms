    "html-minifier-terser": "^7.2.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@qwik.dev/partytown": "^0.13.2",
    "hono": "^4.12.18",
    "zod": "^4.4.3"
  }
